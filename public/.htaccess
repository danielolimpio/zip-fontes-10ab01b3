# ============================================
# Zip Fontes - Apache config (Hostinger)
# SPA routing + HTTPS + security headers + cache
# ============================================

# --- Força HTTPS e domínio canônico (www → não-www) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redireciona www para domínio raiz
  RewriteCond %{HTTP_HOST} ^www\.zipfontes\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://zipfontes.com.br/$1 [R=301,L]

  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # URLs antigas /font/<nome> agora apontam para /fontes/<termo>
  RewriteRule ^font/(.+)$ https://zipfontes.com.br/fontes/$1 [R=301,L]

  # Pré-renderizado por rota: se /<rota>/index.html existir, serve-o
  # Funciona para rotas simples (/icons) e aninhadas (/fontes/fontes-gratis).
  # (mantém meta tags específicas por página para SEO / crawlers).
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # SPA fallback: se não for arquivo nem diretório, serve index.html raiz
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Cabeçalhos de segurança ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Cache imutável para assets versionados
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML nunca deve ser cacheado para garantir deploys novos
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compressão gzip ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# --- Expires (fallback caso mod_headers não esteja ativo) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- MIME types ---
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# --- Bloqueia acesso a arquivos sensíveis ---
<FilesMatch "(^\.|\.(env|git|htaccess|htpasswd|json|lock|md|yml|yaml|ts|tsx|map)$)">
  Require all denied
</FilesMatch>

# Permite explicitamente arquivos públicos necessários
<Files "robots.txt">
  Require all granted
</Files>
<Files "sitemap.xml">
  Require all granted
</Files>
<Files "llms.txt">
  Require all granted
</Files>
<Files "manifest.webmanifest">
  Require all granted
</Files>

# Página de erro custom (SPA cuida do 404)
ErrorDocument 404 /index.html
